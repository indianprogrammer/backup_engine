# Backup protocol to use when not specified on the command line: ftp or sftp
BACKUP_PROTOCOL=sftp

# FTP server settings
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/BACKUP

# SFTP server settings
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASS=
SFTP_REMOTE_DIR=/BACKUP
# Optional: path to a known_hosts file. If empty, host key is scanned automatically when possible.
SFTP_KNOWN_HOSTS=

